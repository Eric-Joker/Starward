<?xml version="1.0" encoding="utf-8" ?>
<!--  启动页右侧「前瞻直播兑换码」：国服直播码展示（点击单条复制）  -->
<UserControl x:Class="Starward.Features.RedeemCode.RedeemCodeButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.RedeemCode"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sh="using:Starward.Helpers"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Button x:Name="Button_RedeemCode"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            CornerRadius="8"
            Loaded="Button_RedeemCode_Loaded"
            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
            Unloaded="Button_RedeemCode_Unloaded">

        <!--  静态「复制」图标（上游为悬浮播放的 Lottie 礼物盒；本分支不使用任何动画）  -->
        <FontIcon FontSize="20"
                  Glyph="&#xE8C8;"
                  IsTextScaleFactorEnabled="False" />

        <Button.Flyout>
            <Flyout Closed="Flyout_RedeemCode_Closed"
                    Opened="Flyout_RedeemCode_Opened"
                    Placement="LeftEdgeAlignedTop">
                <!--  宽度跟内容走：Auto 列让内容决定宽度；下限 200，上限由卡片文案宽度（≤320）兜住  -->
                <Grid MaxHeight="400"
                      MinHeight="80">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  标题（活动名）；活动名拿不到时整块收起，不用占位文案  -->
                    <TextBlock Margin="0,0,0,10"
                               MaxWidth="300"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{x:Bind DisplayTitle}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Visibility="{x:Bind DisplayTitle, Converter={StaticResource ObjectToVisibilityConverter}}" />

                    <!--  隐藏滚动条，仍可用滚轮/触控滚动；MinWidth 让空态/短文案也保持一个像样的宽度  -->
                    <ScrollViewer Grid.Row="1"
                                  MinWidth="200"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="10">
                            <!--  码列表：整行可点复制；子元素不命中，保持手型光标  -->
                            <ItemsControl ItemsSource="{x:Bind Codes}">
                                <!--  间距放在 ItemsPanel 上：StackPanel.Spacing 只加在项与项之间，不会给最后一项留下尾巴  -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RedeemCodeItemView">
                                        <Border Padding="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                PointerEntered="Item_Border_PointerEntered"
                                                PointerExited="Item_Border_PointerExited"
                                                sh:PointerCursor.CursorShape="Hand"
                                                Tapped="Item_Tapped"
                                                Tag="{x:Bind}">
                                            <!--  文案按自身长度撑开卡片；右侧预留 30 给复制图标，避免长文案压到图标  -->
                                            <Grid>
                                                <!--  文案不参与命中，避免 I 型光标与手型切换  -->
                                                <StackPanel MaxWidth="270"
                                                            Margin="0,0,30,0"
                                                            HorizontalAlignment="Left"
                                                            Spacing="4"
                                                            IsHitTestVisible="False">
                                                    <TextBlock FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind RewardText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Visibility="{x:Bind HasRewardText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Text="{x:Bind Code}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!--  右侧：复制 / 成功对勾  -->
                                                <Grid Width="20"
                                                      Height="20"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False">
                                                    <FontIcon FontSize="16"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Glyph="&#xE8C8;"
                                                              Visibility="{x:Bind IsCopied, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                                                    <FontIcon FontSize="16"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Glyph="&#xE8FB;"
                                                              Visibility="{x:Bind IsCopied, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  空态 / 加载失败：同上，用 x:Load 免得在列表底下留一段空白  -->
                            <TextBlock x:Name="TextBlock_EmptyMessage"
                                       HorizontalAlignment="Center"
                                       x:Load="{x:Bind ShowEmptyMessage}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind EmptyMessage}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </ScrollViewer>

                    <!--  加载中  -->
                    <ProgressRing Grid.RowSpan="2"
                                  Width="32"
                                  Height="32"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind IsLoading}"
                                  Visibility="{x:Bind IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
