<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.GameLauncher.GameLaunchProfilePopupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.GameLauncher"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             Title="StarwardLaunchProfilePopup"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <!--  根元素不设 Background：亚克力画在窗口内容后面，根上铺一层画刷（哪怕是 Transparent）
          就等于把系统背景挡掉。仓库里其他模糊窗口（ImageBatchConvertWindow、GameLaunchProfileWindow）
          的根元素同样不设 Background，内容全透明，模糊才透得过来。  -->
    <Grid x:Name="RootGrid">

        <!--  预设列表本体：只用来选预设，底部那颗「编辑预设 / 新增预设」按钮在托盘里不显示
              （见 GameLaunchProfilePopupWindow.xaml.cs 里的 ShowEditButton）。  -->
        <local:GameLaunchProfileFlyout x:Name="LaunchProfileFlyout"
                                       Mode="Panel"
                                       PointerEntered="LaunchProfileFlyout_PointerEntered"
                                       PointerExited="LaunchProfileFlyout_PointerExited"
                                       ProfileSelected="LaunchProfileFlyout_ProfileSelected" />

    </Grid>

</sf:WindowEx>
