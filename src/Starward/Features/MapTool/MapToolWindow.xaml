<?xml version="1.0" encoding="utf-8" ?>
<!--  地图工具：独立窗口，骨架与战绩窗口（BattleChronicleWindow）一致：32px 标题行 + WebView 占满第 1 行  -->
<sf:WindowEx x:Class="Starward.Features.MapTool.MapToolWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.MapTool"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             Title="{x:Bind MapTitle}"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  官方地图名：原神「大地图」、星穹铁道「地图」  -->
        <TextBlock Margin="24,0,144,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   IsTextScaleFactorEnabled="False"
                   Text="{x:Bind MapTitle}"
                   TextTrimming="CharacterEllipsis" />

        <local:MapToolWebView x:Name="mapWebView"
                              Grid.Row="1" />

    </Grid>

</sf:WindowEx>
