<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameAccount.GameAccountSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.GameAccount"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <UserControl.Resources>
        <local:GameAccountUidStringConverter x:Key="GameAccountUidStringConverter" />

        <!--  账号列表和账号中心保持一致：亚克力半透明背景、没有边框、大圆角  -->
        <Style x:Key="GameAccountFlyoutPresenterStyle"
               BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
               TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource CustomAcrylicBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Resources>

    <!--  选择即切换：写的是游戏客户端记住的账号（注册表），每个游戏各记一份  -->
    <Grid Background="{ThemeResource CustomAcrylicBrush}"
          CornerRadius="20"
          Shadow="{StaticResource ThemeShadow}"
          Translation="0,0,16">
        <Button x:Name="Button_GameAccount"
                Height="40"
                MinWidth="200"
                Padding="10,0,12,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="20">
            <Button.Flyout>
                <Flyout x:Name="Flyout_GameAccount"
                        FlyoutPresenterStyle="{StaticResource GameAccountFlyoutPresenterStyle}"
                        Placement="TopEdgeAlignedRight">
                    <ListView x:Name="ListView_GameAccount"
                              MinWidth="200"
                              MaxHeight="300"
                              Padding="4"
                              Background="Transparent"
                              IsItemClickEnabled="True"
                              ItemClick="ListView_GameAccount_ItemClick"
                              ItemsSource="{x:Bind GameAccountList}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!--  这里只是选账号，不需要焦点框  -->
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GameAccount">
                                <Grid Height="40"
                                      Padding="8,0"
                                      ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  游戏内头像来自米游社工具箱里同一个角色的资料  -->
                                    <sc:CachedImage Width="26"
                                                    Height="26"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="100"
                                                    Source="{x:Bind AvatarUrl}" />

                                    <!--  昵称和 UID 放在同一个 TextBlock 里，两条文字才会共用一条基线；
                                          大字号的行高会把整行压得比重写前低 2 DIP，这里抬回去  -->
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Translation="0,-2,0">
                                        <Run Text="{x:Bind Name}" />
                                        <Run Text=" " />
                                        <Run FontSize="12"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             Text="{x:Bind Uid, Converter={StaticResource GameAccountUidStringConverter}}" />
                                    </TextBlock>

                                    <!--  当前账号  -->
                                    <FontIcon Grid.Column="2"
                                              FontSize="12"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Glyph="&#xE73E;"
                                              Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Flyout>
            </Button.Flyout>

            <!--  按钮上就是当前这个游戏账号  -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <sc:CachedImage Width="26"
                                Height="26"
                                VerticalAlignment="Center"
                                CornerRadius="100"
                                Source="{x:Bind SelectGameAccount.AvatarUrl, Mode=OneWay}" />

                <!--  昵称和 UID 放在同一个 TextBlock 里，两条文字才会共用一条基线；
                      大字号的行高会把整行压得比重写前低 2 DIP，这里抬回去  -->
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Translation="0,-2,0">
                    <Run Text="{x:Bind SelectGameAccount.Name, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run FontSize="12"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="{x:Bind SelectGameAccount.Uid, Mode=OneWay, Converter={StaticResource GameAccountUidStringConverter}}" />
                </TextBlock>

                <FontIcon Grid.Column="2"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Glyph="&#xE70D;" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
