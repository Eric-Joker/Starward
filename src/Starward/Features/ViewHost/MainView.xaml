<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.ViewHost.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.ViewHost"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sfb="using:Starward.Features.Background"
             xmlns:sfa="using:Starward.Features.Account"
             xmlns:sc="using:Starward.Controls"
             xmlns:sfg="using:Starward.Features.GameSelector"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>

        <sfb:AppBackground x:Name="AppBackground" CurrentGameId="{x:Bind CurrentGameId}" />


        <Border Width="56"
                HorizontalAlignment="Left"
                Background="{ThemeResource CustomAcrylicBrush}" />


        <Border Name="Border_OverlayMask"
                Background="{ThemeResource CustomAcrylicBrush}"
                Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition />
            </Border.OpacityTransition>
        </Border>


        <NavigationView Name="MainView_NavigationView"
                        CompactPaneLength="56"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        ItemInvoked="NavigationView_ItemInvoked"
                        PaneDisplayMode="LeftCompact">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <!--<Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>-->
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Border Height="52" />
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItemSeparator />
                <!--  启动器  -->
                <NavigationViewItem Name="NavigationViewItem_Launcher"
                                    IsSelected="True"
                                    Tag="GameLauncherPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.MainPage_Launcer}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.MainPage_Launcer}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <!--  游戏设置  -->
                <NavigationViewItem Name="NavigationViewItem_GameSetting"
                                    Tag="GameSettingPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.LauncherPage_GameSetting}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.LauncherPage_GameSetting}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <!--  游戏截图  -->
                <NavigationViewItem Name="NavigationViewItem_Screenshot"
                                    Tag="ScreenshotPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.MainPage_GameScreenshot}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.MainPage_GameScreenshot}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <!--  抽卡记录  -->
                <NavigationViewItem Name="NavigationViewItem_GachaLog" Tag="GachaLogPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF4A5;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock x:Name="TextBlock_GachaLog" VerticalAlignment="Center" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <!--  工具箱  -->
                <NavigationViewItem Name="NavigationViewItem_HoyolabToolbox" Tag="GameRecordPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF133;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock x:Name="TextBlock_HoyolabToolbox" VerticalAlignment="Center" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <!--  账号记录  -->
                <NavigationViewItem Name="NavigationViewItem_SelfQuery"
                                    Tag="SelfQueryPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.SelfQueryPage_AccountRecords}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.SelfQueryPage_AccountRecords}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <!--  千星奇域颂愿  -->
                <NavigationViewItem Name="NavigationViewItem_GenshinBeyondGacha"
                                    Tag="GenshinBeyondGachaPage"
                                    ToolTipService.ToolTip="{x:Bind lang:Lang.GenshinBeyondGachaPage_MiliastraWonderlandOde}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE776;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.GenshinBeyondGachaPage_MiliastraWonderlandOde}" />
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <!--  账号中心：在设置项的上方。外显是账号头像的叠影：最上层（列表里第一个）
                      偏左，最后一个偏右，最多三个；未登录时是通用图标  -->
                <Button x:Name="Button_Account"
                        Width="56"
                        Height="40"
                        Margin="0,0,0,4"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        CornerRadius="8"
                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                    <Button.Flyout>
                        <Flyout x:Name="Flyout_Account"
                                Closed="Flyout_Account_Closed"
                                Opening="Flyout_Account_Opening"
                                Placement="RightEdgeAlignedBottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="{ThemeResource CustomAcrylicBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <sfa:AccountCenterPanel x:Name="Panel_AccountCenter" />
                        </Flyout>
                    </Button.Flyout>

                    <Grid x:Name="Grid_AccountAvatars"
                          Width="46"
                          Height="30"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <!--  后画的盖住先画的，所以最右边的写在最前面、最上层的写在最后；
                              只有一个账号时它落在中间那一层，位置由代码算  -->
                        <sc:CachedImage x:Name="Image_AccountAvatar_3"
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        CornerRadius="100" />
                        <sc:CachedImage x:Name="Image_AccountAvatar_2"
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        CornerRadius="100" />
                        <sc:CachedImage x:Name="Image_AccountAvatar_1"
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        CornerRadius="100" />
                        <!--  一个账号都没有的时候用通用图标，不使用任何官方素材  -->
                        <FontIcon x:Name="Glyph_Account"
                                  FontSize="18"
                                  Glyph="&#xE77B;" />
                    </Grid>
                </Button>
            </NavigationView.PaneFooter>

            <Frame Name="MainView_Frame" Margin="0,48,0,0" />

        </NavigationView>



        <sfg:GameSelector x:Name="GameSelector" CurrentGameChanged="GameSelector_CurrentGameChanged" />


    </Grid>

</UserControl>
